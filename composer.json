{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tcgc/retention-dss",
    "type": "project",
    "description": "TCGC Employee Retention Decision Support System",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/Support/helpers.php"]
    },
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["@php scripts/prepare.php", "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "format": "@php vendor/laravel/pint/builds/pint",
        "setup": ["@php artisan key:generate", "@php artisan migrate --seed"],
        "serve": "@php artisan serve"
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
